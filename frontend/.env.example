# ==========================================================
# Frontend environment template
# ==========================================================
# Copy to `.env.local` (git-ignored). Only VITE_* vars are exposed
# to the browser bundle - never put a secret in this file.
# ==========================================================

# Backend REST base URL (no trailing slash needed)
VITE_API_BASE_URL=http://localhost:8000

# Backend WebSocket base URL (ws:// for local, wss:// behind TLS)
VITE_WS_BASE_URL=ws://localhost:8000