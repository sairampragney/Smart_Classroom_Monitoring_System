# ==========================================================
# Smart Classroom Monitoring System - Environment Template
# ==========================================================
# Copy this file to `.env` (backend root) and/or `frontend/.env.local`.
# REAL .env FILES ARE GIT-IGNORED AND MUST NEVER BE COMMITTED.
#
#   PowerShell:  Copy-Item .env.example backend\.env
#                Copy-Item .env.example frontend\.env.local
# ==========================================================

# ---------- Backend server ----------
# Host/port the FastAPI backend binds to (local demo).
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
BACKEND_LOG_LEVEL=INFO

# ---------- Frontend -> Backend URLs ----------
# Centralized so backend URLs are never hardcoded across the UI.
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_BASE_URL=ws://localhost:8000

# ---------- CORS ----------
# Comma-separated list of ALLOWED origins (no wildcard in production).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------- Arduino / Serial ----------
# Leave the port EMPTY for AUTOMATIC port discovery (recommended).
# Bluetooth pseudo-ports are excluded automatically.
# Set it only when discovery is ambiguous (e.g. two Arduinos connected).
# ARDUINO_PORT is accepted as an alias of SERIAL_PORT.
SERIAL_PORT=
SERIAL_BAUD=9600
SERIAL_READ_TIMEOUT_S=1.0

# ---------- Computer Vision ----------
# 0 = let OpenCV pick the default camera index.
CAMERA_INDEX=0
# Capture/processing frame size (lower = faster on CPU-only laptops).
CV_FRAME_WIDTH=640
CV_FRAME_HEIGHT=480
# Minimum detection confidence threshold (0..1).
CV_MIN_CONFIDENCE=0.5
# Discard a face track after it has been unseen for this many seconds.
CV_TRACK_TIMEOUT_S=1.5

# ---------- Machine Learning ----------
# Path (relative to project root) to the trained model bundle.
ML_MODEL_PATH=ml/artifacts/occupancy_model.joblib
# Minimum probability required to report OCCUPIED rather than EMPTY.
ML_OCCUPIED_THRESHOLD=0.5

# ---------- Storage ----------
# SQLite file used for the History page.
HISTORY_DB_PATH=backend/data/history.db
# Number of rows retained by the history API.
HISTORY_MAX_ROWS=5000

# ---------- Runtime mode ----------
# true  = REAL HARDWARE MODE (default). No simulated data is ever injected.
# false = DEMO MODE (clearly labelled in the UI as "DEMO MODE").
DEMO_MODE=false